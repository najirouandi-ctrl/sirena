# Backend API base URL for the React app
VITE_API_BASE=http://localhost:3001/api

# Port for the local Express server (server/index.js)
PORT=3001

# Cloudinary credentials, used by the /api/upload endpoint
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
